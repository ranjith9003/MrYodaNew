{"status":200,"success":true,"msg":"Tests fetched successfully","total":1,"page":1,"limit":50,"total_pages":1,"total_amount":0,"data":[{"_id":"675921b2ba6f16b8c0d7bee4","package_id":"YDPK035","package_name":"Diabetes Monitor","components":["FBS (GLUCOSE FASTING)","HBA1C","MICROALBUMIN - URINE","PPBS (POST PRANDIAL GLUCOSE)"],"turn_around_time":null,"specimen":"2 mL (1 mL min.) Plasma from 1 Grey Top (Sodium Fluoride) tube AND 3 mL (1.5 mL min.) Whole blood in 1 Lavender Top (EDTA) tube. Ship refrigerated.  DO NOT FREEZE. Special preparation as per glucose sample selected.  F/Fasting sample requires minimum 8 hours fasting. PP/Post prandial sample is 2 hours after starting meal. No restricions for R/Random sample.  Urine 10 ml in a screw cap container","slug":"diabetes-monitor","tests_included":["FBS (GLUCOSE FASTING)","HBA1C","MICROALBUMIN - URINE","PPBS (POST PRANDIAL GLUCOSE)"],"stability":["ROOM = 6 HRS","REFRIGERATED = 24 HRS"],"comment":"","usage":"HbA1c provides an index of average blood glucose levels over the past 8 –12 weeks and is a much better indicator of long term glycemic control as compared to blood and urinary glucose determinations. Since HbA1c reflects long term fluctuations in the blood glucose concentration, a diabetic patient who is recently under good control may still have a high concentration of HbA1c. Converse is true for a diabetic previously under good control but now poorly controlled.","locations":["64870066842708a0d5ae6c77","64870066842708a0d5ae6c74","676a5fa720093d2807af03a5","64870066842708a0d5ae6c75","67346a7655a51ec8ef586bb1","6781186b658e894bfeb119e9","68ecce703d573db19b650c76","68f78da1a5274a337d2d10f8"],"department":[{"_id":"675697b0262d1460f8d55d3b","name":"LAB PACKAGE","createdAt":"2024-12-09T07:09:35.963Z","updatedAt":"2024-12-09T07:09:35.963Z","active":true}],"doctor_speciality":["675697b0262d1460f8d55e5f","675697b0262d1460f8d55e53"],"test_method":["675697b0262d1460f8d55df2"],"organ":[],"doctorsSpeciality":["675697b0262d1460f